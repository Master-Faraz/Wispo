#!/bin/sh
set -e

case "$1" in
    configure)
        # Application files and Python dependencies are installed by the
        # package itself; maintainer scripts must not invoke pip or use the
        # network. Refresh desktop caches when the host provides the tools.
        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if [ -x /usr/bin/gtk-update-icon-cache ]; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        ;;
esac

exit 0
