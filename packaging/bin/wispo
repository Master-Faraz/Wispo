#!/usr/bin/env bash
set -e

# System wrapper for the packaged application. Tarball installations use the
# private offline-installed venv; Debian packages use distribution packages.
# Application code and native whisper.cpp libraries stay under /opt.

WISPO_HOME="/opt/wispo"
if [ ! -d "${WISPO_HOME}/src" ]; then
    echo "Error: Wispo is not installed at ${WISPO_HOME}." >&2
    exit 1
fi

export WISPO_DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/wispo"
export WISPO_DESKTOP_LAUNCHER="/usr/bin/wispo"
export PYTHONPATH="${WISPO_HOME}/src${PYTHONPATH:+:${PYTHONPATH}}"
export LD_LIBRARY_PATH="${WISPO_HOME}/native/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

if [ -x "${WISPO_HOME}/venv/bin/python" ]; then
    exec "${WISPO_HOME}/venv/bin/python" -m wispo.cli "$@"
fi

exec python3 -m wispo.cli "$@"
